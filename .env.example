# Copy this file to .env and add credentials from your personal Spotify app.
# Never commit or share the completed .env file.
#
# Register this exact Spotify redirect URI:
# http://127.0.0.1:5173/login
#
# localhost is not interchangeable with 127.0.0.1.
# Changing the host or port also creates a different browser-storage origin.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
